main.seq2seq_training_args = @seq2seq/Seq2SeqTrainingArguments()
seq2seq/Seq2SeqTrainingArguments.save_total_limit = 1
seq2seq/Seq2SeqTrainingArguments.num_train_epochs = 60
seq2seq/Seq2SeqTrainingArguments.learning_rate = 0.002
seq2seq/Seq2SeqTrainingArguments.lr_scheduler_type = 'cosine'
seq2seq/Seq2SeqTrainingArguments.per_device_train_batch_size = 128
seq2seq/Seq2SeqTrainingArguments.per_device_eval_batch_size = 128
seq2seq/Seq2SeqTrainingArguments.warmup_steps = 100
seq2seq/Seq2SeqTrainingArguments.weight_decay = 0.01
seq2seq/Seq2SeqTrainingArguments.eval_strategy = 'epoch'
seq2seq/Seq2SeqTrainingArguments.save_strategy = 'epoch'
seq2seq/Seq2SeqTrainingArguments.predict_with_generate = True
seq2seq/Seq2SeqTrainingArguments.generation_max_length = 10
seq2seq/Seq2SeqTrainingArguments.remove_unused_columns = False
seq2seq/Seq2SeqTrainingArguments.metric_for_best_model = 'eval_sequence_accuracy'
seq2seq/Seq2SeqTrainingArguments.greater_is_better = True
seq2seq/Seq2SeqTrainingArguments.report_to = 'none'

evaluate_tpe.tpe_training_args = @tpe_eval/Seq2SeqTrainingArguments()
tpe_eval/Seq2SeqTrainingArguments.per_device_eval_batch_size = 64
tpe_eval/Seq2SeqTrainingArguments.remove_unused_columns = False
tpe_eval/Seq2SeqTrainingArguments.predict_with_generate = True
tpe_eval/Seq2SeqTrainingArguments.generation_max_length = 10
tpe_eval/Seq2SeqTrainingArguments.report_to = 'none'

main.do_hyperparameter_search = False
main.skip_seq2seq = False
main.tpe_training_args = @tpe/TrainingArguments()
tpe/TrainingArguments.save_total_limit = 1
tpe/TrainingArguments.num_train_epochs = 20
tpe/TrainingArguments.learning_rate = 0.002
tpe/TrainingArguments.lr_scheduler_type = 'constant'
tpe/TrainingArguments.per_device_train_batch_size = 64
tpe/TrainingArguments.per_device_eval_batch_size = 64
tpe/TrainingArguments.warmup_steps = 100
tpe/TrainingArguments.weight_decay = 0.01
tpe/TrainingArguments.eval_strategy = 'epoch'
tpe/TrainingArguments.save_strategy = 'epoch'
tpe/TrainingArguments.remove_unused_columns = False
tpe/TrainingArguments.metric_for_best_model = 'eval_loss'
tpe/TrainingArguments.greater_is_better = False
tpe/TrainingArguments.load_best_model_at_end = True
tpe/TrainingArguments.report_to = 'none'
