holdout_eval.sentences_path = 'data/sentences_multiple_filler_role_holdout'
holdout_eval.embedding_cache_path = 'data/sentences_multiple_filler_role_holdout'
holdout_eval.embedding_model_name = 'nomic-ai/modernbert-embed-base'
holdout_eval.tpe_path = 'experiments/sentences/filler_role_holdout/checkpoints/modernbert/tpe'
holdout_eval.results_output_path = 'experiments/sentences/filler_role_holdout/checkpoints/modernbert/tpe/holdout_eval_metrics.json'
holdout_eval.probe_results_output_path = 'experiments/sentences/filler_role_holdout/checkpoints/modernbert/tpe/probe_compare_results_svo.json'
holdout_eval.trained_probe_cache_path = 'experiments/sentences/filler_role_holdout/checkpoints/modernbert/tpe/trained_probe_results_svo_holdout.json'
holdout_eval.roles_to_eval = ('subj', 'verb', 'obj')
holdout_eval.split_names = ('test', 'generalization')
holdout_eval.regularization = 'l2'
holdout_eval.reg_param = None
holdout_eval.analytic_training_args = @analytic/TrainingArguments()

analytic/TrainingArguments.output_dir = 'experiments/sentences/filler_role_holdout/checkpoints/modernbert/probe_eval/analytic'
analytic/TrainingArguments.overwrite_output_dir = True
analytic/TrainingArguments.per_device_eval_batch_size = 256
analytic/TrainingArguments.remove_unused_columns = False
analytic/TrainingArguments.report_to = 'none'

holdout_eval.trainable_training_args = @trainable/TrainingArguments()
trainable/TrainingArguments.output_dir = 'experiments/sentences/filler_role_holdout/checkpoints/modernbert/probe_eval/trainable'
trainable/TrainingArguments.overwrite_output_dir = True
trainable/TrainingArguments.save_total_limit = 1
trainable/TrainingArguments.per_device_train_batch_size = 256
trainable/TrainingArguments.per_device_eval_batch_size = 256
trainable/TrainingArguments.num_train_epochs = 20
trainable/TrainingArguments.learning_rate = 0.005
trainable/TrainingArguments.lr_scheduler_type = 'constant'
trainable/TrainingArguments.save_strategy = 'epoch'
trainable/TrainingArguments.remove_unused_columns = False
trainable/TrainingArguments.report_to = 'none'
