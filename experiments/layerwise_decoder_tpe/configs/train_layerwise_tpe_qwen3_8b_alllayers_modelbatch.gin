# Layerwise ModelBatch TPE training for Qwen/Qwen3-8B (all decoder layers).
include 'experiments/layerwise_decoder_tpe/configs/layerwise_tpe_modelbatch_base.gin'

main.embedding_model_name = 'Qwen/Qwen3-8B'

main.tpe_config = {
    'filler_dim': 128,
    'role_dim': 4,
    'aggregation': 'sum',
    'has_linear_layer': True,
}

layerwise_tpe/TrainingArguments.output_dir = './experiments/layerwise_decoder_tpe/checkpoints/qwen3-8b_layers_all_modelbatch'
layerwise_tpe/TrainingArguments.learning_rate = 0.002
