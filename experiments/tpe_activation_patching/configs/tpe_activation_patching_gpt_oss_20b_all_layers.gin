# Gin config for TPE-driven activation patching on GPT-OSS-20B (all layers).

tpe_activation_patching.run_tpe_activation_patching.sentences_path = 'data/sentences/data.test'
tpe_activation_patching.run_tpe_activation_patching.output_dir = 'experiments/tpe_activation_patching/results/gpt-oss-20b-all-layers'
tpe_activation_patching.run_tpe_activation_patching.model_id = 'openai/gpt-oss-20b'
tpe_activation_patching.run_tpe_activation_patching.device = 'cuda'
tpe_activation_patching.run_tpe_activation_patching.dtype = 'bfloat16'
tpe_activation_patching.run_tpe_activation_patching.tpe_checkpoint_path = 'experiments/layerwise_decoder_tpe/checkpoints/openai_gpt-oss-20b_layers_all_modelbatch'
tpe_activation_patching.run_tpe_activation_patching.tpe_device = 'cuda'
tpe_activation_patching.run_tpe_activation_patching.tpe_dtype = 'float32'
tpe_activation_patching.run_tpe_activation_patching.max_trials = 12
tpe_activation_patching.run_tpe_activation_patching.token_focus = 'all'
tpe_activation_patching.run_tpe_activation_patching.layer_indices = 'all'
tpe_activation_patching.run_tpe_activation_patching.explicit_token_positions = None
tpe_activation_patching.run_tpe_activation_patching.random_seed = 7
